# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables
.env
.env.*
!.env.example
lib/core/env/env.g.dart

# Kunci rilis Android, di mana pun letaknya
key.properties
*.keystore
*.jks

# Path SDK lokal, di mana pun letaknya
local.properties

# Build keluaran di subfolder (mis. android/app/build)
build/

# ML: hanya kode dan dokumen yang masuk git (ml/.gitignore juga menjaga ini)
ml/dataset/
ml/reports/
ml/data_public/*
!ml/data_public/README.md
!ml/data_public/.gitignore
ml/**/*.jpg
ml/**/*.jpeg
ml/**/*.png
ml/**/*.zip
ml/**/__pycache__/
ml/.venv/

# Sisa lokal: skrip coba-coba, folder lama sebelum app pindah ke root, dan hasil audit PCD
/scratch/
/reksatani_app/
/audit_pcd_tmp/
